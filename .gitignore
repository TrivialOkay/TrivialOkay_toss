# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
/.next/
/.vinext/
/dist/
/miniapp-dist/
/out/
/coverage/
*.ait
*.tsbuildinfo

# Apps in Toss / Cloudflare local state
/.wrangler/
.dev.vars
.dev.vars.*

# Environment files (keep the documented template)
.env
.env.*
!.env.example

# Python environments and caches
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Temporary/generated workspace files
/outputs/
/work/
/tmp/
/.codex_tmp_*/
*.pid

# AI agent local state (keep shared settings, ignore per-user files)
.claude/settings.local.json
.claude/local/

# Local editor and OS files
/.idea/
/.vscode/
/.vs/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*.pem

# Blender backup and unsaved scratch files
*.blend[0-9]
**/Untitled.blend
